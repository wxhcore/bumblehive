{
  "name": "bumblehive-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/doctor.mjs && concurrently --kill-others-on-fail --names server,web --prefix-colors yellow,cyan \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "node scripts/python-task.mjs server",
    "dev:web": "pnpm --filter bumblehive-webui run dev",
    "dev:desktop": "node scripts/desktop-task.mjs dev",
    "build:sidecar": "node scripts/python-task.mjs sidecar",
    "build:desktop": "node scripts/desktop-task.mjs build",
    "test": "node scripts/python-task.mjs test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "10.33.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
