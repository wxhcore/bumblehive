{
  "name": "bumblehive-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:desktop": "node scripts/setup.mjs --desktop",
    "dev": "node scripts/doctor.mjs && concurrently --kill-others-on-fail --names server,web --prefix-colors yellow,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node scripts/python-task.mjs server",
    "dev:web": "npm --prefix webui run dev",
    "dev:desktop": "node scripts/desktop-task.mjs dev",
    "build:desktop": "node scripts/desktop-task.mjs build",
    "test": "node scripts/python-task.mjs test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
