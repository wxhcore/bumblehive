{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BumbleHive",
  "version": "0.1.0",
  "identifier": "com.bumblehive.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../webui run dev",
    "beforeBuildCommand": "npm --prefix ../webui run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../webui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BumbleHive",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/bumblehive-server/": "sidecar/bumblehive-server/"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
